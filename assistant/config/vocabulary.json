  },
  "statuses": {
    "In Maintenance": {
      "pattern": "in maintenance|in repair|under repair|being repaired|faulty|broken|being fixed",
      "phrase": "in maintenance"
    },
    "Available": {
      "pattern": "available|spare|in stock|unassigned|free",
      "phrase": "available"
    },
    "Assigned": {
      "pattern": "assigned|in use|issued",
      "phrase": "assigned"
    },
    "Retired": {
      "pattern": "retired|decommissioned",
      "phrase": "retired"
    },
    "Lost": {
      "pattern": "\\blost\\b|missing",
      "phrase": "lost"
    }
  },
