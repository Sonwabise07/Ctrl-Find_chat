        "locations?|offices?|sites?|branch(?:es)?",
        "location"
      ],
      [
        "departments?|teams?",
        "department"
      ],
      [
        "types?|categories|category|kinds?",
        "type"
      ],
      [
        "statuses|status",
        "status"
      ]
    ],
    "blockers": "exception|warrant|repair|maintenance|confirm|aod|dashboard|chart|graph|trend"
