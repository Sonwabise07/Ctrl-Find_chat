    "lowest": "least|fewest|lowest|smallest|bottom",
    "value": "value|worth|cost|costs|costly|spend|spent|price|expensive|priciest",
    "limit": "(?:top|bottom|first)\\s+(\\d+|one|two|three|four|five|six|seven|eight|nine|ten)\\b",
    "dimensions": [
