  "group_by": [
    [
      "by status|per status|each status|lifecycle",
      "status"
    ],
    [
      "by (asset )?type|per type|each type|by category|asset types?|types of assets?|what types|asset categories",
      "type"
    ],
    [
      "by (location|office)|per (location|office)|each (location|office)",
      "location"
    ],
    [
      "by department|per department|each department",
      "department"
    ]
  ],
  "messages": {
    "out_of_scope": "That question falls outside my supported scope — I can only answer from this system's own asset data (cost comparisons, counts by status, overdue confirmations, warranty timelines).",
    "people_hint": " Try Oracle or HR reporting for headcount.",
    "not_held": "That information isn't held in this system yet, so I can't answer it rather than guess.",
    "person_not_found": "I couldn't find that person in this system. Try their full name.",
    "unknown_entity": "I don't have a location or department called “{name}” in this system. I can answer for: {locations}.",
