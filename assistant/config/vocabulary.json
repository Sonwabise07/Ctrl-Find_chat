        "\\b(charts?|graphs?|plot|plotted|trends?|visuali[sz]e|visuali[sz]ation|over time|per month|by month|monthly)\\b"
      ]
    },
    {
      "intent": "aod_cases",
      "all": [
        "\\baod\\b|acknowledg(e)?ment of debt",
        "\\b(cases?|who|list|owe[sd]?|employees?|people|records?|outstanding)\\b"
      ]
    },
    {
      "intent": "open_aod_value",
      "all": [
        "\\baod\\b|acknowledg(e)?ment of debt"
      ]
    },
    {
      "intent": "unconfirmed_assets",
      "all": [
        "unconfirmed|not (yet )?confirmed|pending confirm|awaiting confirm|no reply|not (yet )?responded|yet to confirm|outstanding confirm"
      ]
    },
    {
      "intent": "overdue_confirmations",
      "all": [
        "overdue",
        "confirm"
      ]
    },
    {
      "intent": "audit_exceptions_by_location",
      "all": [
        "exception"
      ]
    },
    {
      "intent": "warranty_assets",
      "all": [
        "warrant"
      ]
    },
    {
      "intent": "maintenance_cost_by_period",
      "all": [
        "spend|spent|cost|purchases|bought|compare",
        "repair|maintenance"
      ]
    },
    {
      "intent": "spend_by_period",
      "all": [
        "spend|spent|cost|purchases|bought|acquisition"
      ]
    },
    {
      "intent": "maintenance_open",
      "all": [
        "\\b(cases?|records?|tickets?|faults?|open (repairs?|maintenance)|jobs?)\\b",
        "repair|maintenance|fault"
      ]
    },
    {
      "intent": "team_assets",
      "all": [
        "\\b(my|our)\\s+(team|department|dept)\\b"
      ]
    },
    {
      "intent": "my_assets",
      "all": [
        "\\bmy\\s+(assets?|laptops?|monitors?|desktops?|phones?|tablets?|printers?|devices?|equipment|kit)\\b|\\bassigned to me\\b|\\bwhat (do|am) i (have|hold|own|responsible)\\b|\\bwhat am i responsible for\\b"
      ]
    },
    {
      "intent": "open_loss_cases",
      "all": [
        "\\b(stolen|thefts?|loss(?:es)?|incidents?)\\b"
      ]
    },
    {
      "intent": "unrecovered_assets",
      "all": [
        "\\b(left|leavers?|leaving|inactive|former|exited|offboard\\w*|resigned|departed|no longer (?:with|employed|working))\\b",
        "\\b(assets?|laptops?|equipment|devices?|kit|recover\\w*|return\\w*|held|hold|assigned)\\b"
      ]
    },
    {
      "intent": "laptop_ages",
      "all": [
        "\\b(how old|laptop ages?|ages? of (?:our |the )?laptops|laptop health|health of (?:our |the )?laptops|ageing laptops|aging laptops)\\b"
      ]
    }
  ],
  "types": {
