{
  "blocked": "head ?count|how many (employees|staff|people)|salary|salaries|payroll|depreciat|valuation|book value|weather|share price|revenue|leave balance",
  "people": "head ?count|employees|staff|people|salary|salaries|payroll|leave",
  "asset_nouns": "\\b(assets?|laptops?|notebooks?|monitors?|screens?|displays?|desktops?|pcs?|phones?|mobiles?|tablets?|ipads?|printers?|devices?|equipment|stock|inventory|switch(es)?|routers?|macbooks?)\\b",
  "phrases": {
    "spare": "spare|stock",
    "how_many": "how many",
    "count": "how many|count|number of|total",
    "list": "\\b(show|list|which|what|give|display|find|see|all)\\b",
    "holds": "\\b(have|has|assigned|holds?|using|owns?|issued|with)\\b",
    "dashboard": "dashboards?",
    "chart": "\\b(charts?|graphs?|plot|plotted|trends?|visuali[sz]e|visuali[sz]ation|over time|per month|by month|monthly)\\b",
    "compare": "\\b(compare|compared|versus|vs|against|than|more|less|difference)\\b",
